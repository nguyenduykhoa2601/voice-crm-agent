GEMINI_API_KEY=
# Optional: pin one Live model. Leave empty to auto-select with fallback to the next
# available model (recommended: gemini-3.1-flash-live-preview is tried first anyway).
# Pinning disables the fallback.
GEMINI_LIVE_MODEL=
ESPO_URL=https://demo.us.espocrm.com
MAX_SESSIONS=3
HEADLESS=1
PORT=7860
