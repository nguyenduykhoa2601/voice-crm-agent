{
  "version": 1,
  "notes": [
    "{rid} is replaced by a short unique run id per run.",
    "expect.tools_any: at least one listed tool should be called in that turn (soft check, logged). expect.tools_none: none of these may be called in that turn (hard check).",
    "expect.must_not_claim_success: true means any agent utterance claiming saved/created/moved/done in that turn fails the scenario (hard check).",
    "success: after the last turn a record found by lookup must exist and match fields (case-insensitive, trimmed; phone digits only). expect_count, if present, is the exact number of matching records.",
    "forbid: no record matching lookup may exist after the scenario.",
    "<silence Ns>: send nothing for N seconds. <barge_in>: send while the agent is still speaking (text mode: send right after the first agent chunk).",
    "Tool names: get_screen, open_create_form, fill_fields, save, cancel, find_records, open_record, edit_record, set_stage."
  ],
  "scenarios": [
    {
      "id": "S01",
      "title": "Happy path, guided create contact",
      "workflow": "create_contact",
      "tags": [
        "happy_path",
        "guided",
        "read_back"
      ],
      "turns": [
        {
          "user": "Hi, I'd like to add a new contact.",
          "expect": {
            "agent": "Says one short sentence and opens the Create Contact form; asks for the name.",
            "tools_any": [
              "open_create_form"
            ],
            "tools_none": [
              "save"
            ],
            "must_not_claim_success": true
          }
        },
        {
          "user": "Maya Okafor.",
          "expect": {
            "agent": "Fills first name Maya and last name Okafor; asks for email and/or phone.",
            "tools_any": [
              "fill_fields"
            ],
            "tools_none": [
              "save"
            ],
            "must_not_claim_success": true
          }
        },
        {
          "user": "maya.okafor+{rid}@example.com",
          "expect": {
            "agent": "Fills the email; asks for phone.",
            "tools_any": [
              "fill_fields"
            ],
            "tools_none": [
              "save"
            ],
            "must_not_claim_success": true
          }
        },
        {
          "user": "Four one five, five five five, zero one nine eight.",
          "expect": {
            "agent": "Fills phone; reads back name, email and phone and asks to confirm saving.",
            "tools_any": [
              "fill_fields"
            ],
            "tools_none": [
              "save"
            ],
            "must_not_claim_success": true
          }
        },
        {
          "user": "Yes, save it.",
          "expect": {
            "agent": "Saves, then states one verified fact from the detail view.",
            "tools_any": [
              "save"
            ],
            "must_not_claim_success": false
          }
        }
      ],
      "success": {
        "entity": "Contact",
        "lookup": {
          "emailAddress": "maya.okafor+{rid}@example.com"
        },
        "fields": {
          "firstName": "Maya",
          "lastName": "Okafor",
          "phoneNumber": "4155550198"
        }
      }
    },
